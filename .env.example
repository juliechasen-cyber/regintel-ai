# RegIntel AI configuration — copy to .env and fill in.
# .env is gitignored. Never commit a real key.

# --- Required for answer generation (retrieval works without it) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Model ---
# Claude 5 family. Sonnet is a good default for grounded Q&A; Haiku is cheaper,
# Opus is strongest.
REGINTEL_MODEL=claude-sonnet-5-5
REGINTEL_MAX_TOKENS=2048
REGINTEL_TEMPERATURE=0.0

# --- Chunking ---
REGINTEL_CHUNK_TOKENS=800
REGINTEL_CHUNK_OVERLAP=120
# 1 = each chunk stays within one page so citations carry an exact page number.
REGINTEL_RESPECT_PAGES=1

# --- Embeddings ---
REGINTEL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# 1 = fall back to the offline hashing embedder if the model cannot load.
# Set to 0 in production to fail loudly instead of degrading silently.
REGINTEL_ALLOW_OFFLINE_EMBEDDER=1

# --- Vector store ---
REGINTEL_CHROMA_PATH=./data/chroma
REGINTEL_COLLECTION=regintel

# --- Retrieval ---
REGINTEL_TOP_K=6
