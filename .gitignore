# --- Secrets: never commit ---
.env
.env.local
*.key

# --- Source documents and derived index ---
# Regulator PDFs are public but large; the repo stays code-only and the
# downloader rebuilds the corpus. data/sources.json IS tracked (see negation).
data/pdfs/
data/chroma/
data/*.sqlite3
!data/sources.json

# --- Evaluation output ---
eval/results/
*.eval.json

